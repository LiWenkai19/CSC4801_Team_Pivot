# Optional settings. The app does not automatically load this file.
# Omit SECRET_KEY for a generated key (sessions expire on server restart).
# SECRET_KEY=replace-with-a-random-local-secret
# DATABASE=/absolute/path/to/local-demo.sqlite3
# PORT=8080

# FastAPI settings for local development. Copy this file to backend/.env.
# Settings reads .env from the process working directory; run backend commands there.
# Create this LOCAL/DEMO database and role as described in INSTALL.md.
APP_NAME=CSC4801 Final Project
DATABASE_URL=postgresql+psycopg://skillmatch:local-demo-only@127.0.0.1:5432/skillmatch
COOKIE_SECURE=false
