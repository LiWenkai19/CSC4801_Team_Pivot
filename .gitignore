# ===== 敏感配置(最重要!绝不能提交)=====
# .env 含 SECRET_KEY、数据库密码、superadmin 密码等,泄露 = 安全事故
backend/.env
*.env
# 但允许提交示例模板(不含真实密钥)
!.env.example

# ===== AI 工具指令与本地配置（所有目录） =====
.agents/
.agent/
.claude/
.claude.json
.codex/
.kilo/
[Aa][Gg][Ee][Nn][Tt].[Mm][Dd]
[Aa][Gg][Ee][Nn][Tt][Ss].[Mm][Dd]
[Aa][Gg][Ee][Nn][Tt][Ss].override.[Mm][Dd]
[Cc][Ll][Aa][Uu][Dd][Ee].[Mm][Dd]
[Cc][Ll][Aa][Uu][Dd][Ee].local.[Mm][Dd]
backend/data/

# ===== Agent 技能包与技能定义 =====
/skills/
**/.*/**/skills/
[Ss][Kk][Ii][Ll][Ll].[Mm][Dd]

# ===== 本地工作文档与模板 =====
/docs/*
!/docs/README.md
!/docs/REQUIREMENTS.md
!/docs/DOCKER.md
!/docs/PEER_REVIEW.md
!/docs/testing/
/docs/testing/history/
/docs/testing/failed-cases.json
/docs/testing/findings.json
* 中文翻译.md
/backend/alembic/README
/backend/app/**/PLAN.md
/backend/app/**/PROGRESS.md
/backend/app/**/REQUIREMENTS.md
/frontend/PROGRESS.md
/frontend/README.md
/frontend/src/**/REQUIREMENTS.md

# ===== Python =====
# Python 字节码缓存目录
__pycache__/
# 编译产物 .pyc / .pyo / .pyd
*.py[cod]
*$py.class
# pip install -e 生成的包元数据
*.egg-info/
.eggs/
build/
dist/

# ===== 虚拟环境 =====
# 你用 Conda 环境 SYManage,一般不在项目内;但以防万一本地建了 venv
.venv/
venv/
env/

# ===== 测试 / 工具缓存 =====
# pytest 缓存
.pytest_cache/
# ruff 缓存
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ===== 数据库本地文件 =====
# 你用 PostgreSQL,一般不产生本地 db 文件;但如果偶尔用 SQLite 调试
*.sqlite3
*.db

# ===== IDE / 编辑器 =====
.vscode/
.idea/
*.swp

